rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App needs to read servers, networks and settings. Only admin writes.
    match /servers/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /networks/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // User records: admin only, both read and write.
    match /users/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
